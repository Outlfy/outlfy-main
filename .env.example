# Outlfy Admin Panel Environment Variables
# Copy this file to .env.local and update with your actual values

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/outlfy
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/outlfy

# Admin Configuration
ADMIN_EMAIL=admin@outlfy.com
ADMIN_PASSWORD=your-secure-password

# Email Configuration (for form notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin

# Security
NEXTAUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=http://localhost:3000

# Optional: Webhook URLs for notifications
WEBHOOK_URL=https://hooks.slack.com/your-webhook-url
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your-webhook

# File Upload (if implementing file uploads for case studies)
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=5242880

# Analytics (optional)
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
